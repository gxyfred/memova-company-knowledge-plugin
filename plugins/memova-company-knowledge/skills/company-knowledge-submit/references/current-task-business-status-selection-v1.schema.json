{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurrentTaskBusinessStatusSelectionV1",
  "description": "Bounded business-status fields selected from the current Codex task. The server owns source identity, locator, revision, evidence anchors, and knowledge-owner identity.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"current_status": {"const": "done"}},
        "required": ["current_status"]
      },
      "then": {
        "properties": {"next_action": {"type": "null"}},
        "required": ["completion_evidence"]
      }
    },
    {
      "if": {
        "properties": {
          "current_status": {
            "enum": ["planned", "in_progress", "blocked", "superseded", "unknown"]
          }
        },
        "required": ["current_status"]
      },
      "then": {
        "properties": {
          "next_action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {"type": "string", "minLength": 3, "maxLength": 2000},
              "owner": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {"enum": ["user_upn", "role"]},
                  "value": {"type": "string", "minLength": 1, "maxLength": 320}
                },
                "required": ["kind", "value"]
              },
              "due_or_review_at": {"type": "string", "format": "date-time"}
            },
            "required": ["description", "owner", "due_or_review_at"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"current_status": {"const": "blocked"}},
        "required": ["current_status"]
      },
      "then": {"properties": {"blockers": {"minItems": 1}}, "required": ["blockers"]}
    },
    {
      "if": {
        "anyOf": [
          {"required": ["previous_receipt_id"]},
          {"required": ["supersedes_knowledge_id"]},
          {"required": ["correction_reason"]}
        ]
      },
      "then": {
        "required": ["previous_receipt_id", "supersedes_knowledge_id", "correction_reason"]
      }
    }
  ],
  "properties": {
    "client_request_id": {
      "description": "Fresh UUID for this exact prepare request.",
      "type": "string",
      "format": "uuid"
    },
    "current_task_id": {
      "description": "Stable non-secret identifier for the current Codex task; not a URL.",
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]{3,128}$"
    },
    "selection_id": {
      "description": "Stable identifier for the explicitly selected bounded fields.",
      "type": "string",
      "pattern": "^sel_[A-Za-z0-9_-]{3,128}$"
    },
    "observed_at": {
      "description": "When the selected current-task evidence was observed.",
      "type": "string",
      "format": "date-time"
    },
    "business_object_id": {
      "description": "Business object or test marker whose status is being recorded.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,254}$"
    },
    "status_as_of": {"type": "string", "format": "date-time"},
    "current_status": {
      "enum": ["planned", "in_progress", "blocked", "done", "cancelled", "superseded", "unknown"]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["user_upn", "role"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 320}
      },
      "required": ["kind", "value"]
    },
    "next_action": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {"type": "string", "minLength": 3, "maxLength": 2000},
            "owner": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {"enum": ["user_upn", "role"]},
                "value": {"type": "string", "minLength": 1, "maxLength": 320}
              },
              "required": ["kind", "value"]
            },
            "due_or_review_at": {"type": "string", "format": "date-time"}
          },
          "required": ["description", "owner", "due_or_review_at"]
        },
        {"type": "null"}
      ]
    },
    "deadline_or_review_at": {"type": "string", "format": "date-time"},
    "selection_reason": {
      "description": "Why these bounded fields were explicitly selected for company-public publication.",
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 1000},
      "maxItems": 50
    },
    "milestone": {"type": "string", "minLength": 1, "maxLength": 500},
    "sanitized_metric_summary": {"type": "string", "maxLength": 4000},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "maxItems": 50
    },
    "completion_evidence": {"type": "string", "minLength": 20, "maxLength": 4000},
    "redactions_applied": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {"type": "string", "minLength": 1, "maxLength": 100},
          "scope": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "required": ["action", "scope"]
      }
    },
    "excluded_evidence_summary": {"type": "string", "maxLength": 2000},
    "previous_receipt_id": {
      "type": "string",
      "pattern": "^rcpt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "supersedes_knowledge_id": {
      "type": "string",
      "pattern": "^kn_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correction_reason": {"type": "string", "minLength": 20, "maxLength": 2000}
  },
  "required": [
    "client_request_id",
    "current_task_id",
    "selection_id",
    "observed_at",
    "business_object_id",
    "status_as_of",
    "current_status",
    "owner",
    "next_action",
    "deadline_or_review_at",
    "selection_reason"
  ]
}
