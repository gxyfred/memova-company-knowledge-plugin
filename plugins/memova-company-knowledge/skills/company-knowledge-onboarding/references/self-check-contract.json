{
  "contract_version": "1.3",
  "plugin_version": "0.4.6",
  "mcp_server": "company_knowledge_assistant",
  "required_tools": [
    "get_profile",
    "answer",
    "search",
    "fetch",
    "prepare_knowledge_submission",
    "submit_knowledge_candidate",
    "get_publication_status"
  ],
  "receipt_types": [
    "general_knowledge",
    "code_change",
    "business_status",
    "document_or_meeting",
    "file_or_media",
    "design_change",
    "deployment_or_incident"
  ],
  "statuses": [
    "pass",
    "fail",
    "not_run",
    "not_applicable"
  ],
  "oauth_bootstrap": {
    "runs_before_required_gates": true,
    "status_command": "codex mcp list",
    "login_command": "codex mcp login company_knowledge_assistant",
    "logout_command": "codex mcp logout company_knowledge_assistant",
    "login_actor": "employee_completes_microsoft_browser_login",
    "credential_handling": "never_request_capture_print_or_persist_credentials",
    "restart_after_login": "fully_restart_codex_then_start_new_conversation",
    "states": {
      "server_absent": "stop_with_host_binding_missing",
      "server_disabled": "stop_with_host_binding_disabled",
      "not_logged_in": "launch_employee_oauth_then_recheck_status",
      "authenticated_tools_missing": "stop_with_authenticated_host_binding_missing",
      "authenticated_required_tools_present": "continue_to_required_gates"
    }
  },
  "retry_policy": {
    "maximum_total_attempts": 3,
    "maximum_additional_retries": 2,
    "retryable": [
      "transient_network",
      "transient_dependency",
      "connection_interrupted"
    ],
    "non_retryable": [
      "unauthorized_employee",
      "application_disabled_by_admin",
      "wrong_tenant",
      "missing_site_permission",
      "identity_mismatch",
      "admin_consent_required",
      "policy_denied"
    ]
  },
  "answer_probe": {
    "question_template": "CKP-SELF-CHECK-UNPUBLISHED-{uuid}",
    "uuid_requirement": "fresh_uuid_v4_per_run",
    "time_scope": {"mode": "current", "as_of": null},
    "filters": {},
    "selected_knowledge_ids": [],
    "expected_status": "insufficient_evidence",
    "expected_knowledge_gap_reason": "no_matching_knowledge",
    "expected_citations": [],
    "expected_conflicts": [],
    "expected_freshness": {"currentness": "unknown", "answer_as_of": null},
    "expected_policy_version": "non_empty"
  },
  "preview_cancel_rehearsal": {
    "receipt_type": "general_knowledge",
    "tool": "prepare_knowledge_submission",
    "tool_argument": "current_task_general_knowledge",
    "source_provenance": "server_owned",
    "source_locator_from_employee": false,
    "synthetic_content_only": true,
    "submit_for_cancel": false,
    "preview_ttl_minutes": 30
  },
  "remote_mutation_boundaries": {
    "profile_and_query": "read_only",
    "prepare_knowledge_submission": "exact_submission_intent_or_exact_candidate_selection_no_redundant_confirmation",
    "submit_knowledge_candidate": "durable_remote_write_requires_single_final_exact_confirmation",
    "daily_submission_formal_confirmation_count": 1,
    "cancel": "do_not_submit_and_allow_preview_to_expire",
    "preview_ttl_minutes": 30,
    "rollback": "forward_correction_or_recovery_never_delete"
  },
  "gates": [
    {
      "id": "INSTALL_VERSION",
      "required": true,
      "mode": "local",
      "pass_condition": "plugin_version_is_0_4_6_or_newer"
    },
    {
      "id": "FRESH_SESSION",
      "required": true,
      "mode": "host",
      "pass_condition": "new_conversation_started_after_install_or_update"
    },
    {
      "id": "MCP_TOOL_SURFACE",
      "required": true,
      "mode": "host_after_oauth_bootstrap",
      "pass_condition": "authenticated_dedicated_server_exposes_all_required_tools"
    },
    {
      "id": "MICROSOFT_OAUTH_PROFILE",
      "required": true,
      "mode": "read_only",
      "pass_condition": "get_profile_succeeds_with_delegated_employee_identity"
    },
    {
      "id": "SELF_IDENTITY_MATCH",
      "required": true,
      "mode": "user_confirmation",
      "pass_condition": "employee_confirms_safe_profile_is_their_own"
    },
    {
      "id": "JOB_AND_CAPABILITY_RESOLUTION",
      "required": true,
      "mode": "read_only",
      "pass_condition": "job_is_explanatory_and_explicit_capabilities_are_authoritative"
    },
    {
      "id": "SEVEN_RECEIPT_TYPES",
      "required": true,
      "mode": "read_only",
      "pass_condition": "all_frozen_receipt_types_are_declared_and_live_support_is_not_overclaimed"
    },
    {
      "id": "QUERY_AND_SNAPSHOT",
      "required": true,
      "mode": "read_only",
      "pass_condition": "fresh_unpublished_uuid_probe_returns_the_frozen_insufficient_evidence_gap_freshness_and_policy_contract"
    },
    {
      "id": "PREVIEW_CANCEL",
      "required": true,
      "mode": "approval_gated_ephemeral_write",
      "pass_condition": "employee_previews_server_owned_current_task_general_knowledge_under_own_delegated_identity_then_does_not_submit"
    },
    {
      "id": "CONFIRM_DELEGATED_PUBLICATION",
      "required": true,
      "mode": "approval_gated_durable_write",
      "pass_condition": "employee_gives_single_final_confirmation_and_sharepoint_receipt_submitter_match_own_identity"
    },
    {
      "id": "PERMISSION_NEGATIVE",
      "required": true,
      "mode": "synthetic_negative",
      "pass_condition": "server_denies_cross_employee_or_unauthorized_target_access"
    },
    {
      "id": "SENSITIVE_DATA_NEGATIVE",
      "required": true,
      "mode": "synthetic_negative",
      "pass_condition": "inert_secret_and_personal_data_markers_are_rejected_or_excluded"
    },
    {
      "id": "NO_THIRD_PARTY_OAUTH",
      "required": true,
      "mode": "local",
      "pass_condition": "p0_requests_no_third_party_connection_or_oauth"
    },
    {
      "id": "NO_CREDENTIAL_CAPTURE",
      "required": true,
      "mode": "local",
      "pass_condition": "workflow_never_requests_or_persists_credentials_tokens_cookies_or_mfa"
    }
  ],
  "employee_completion": {
    "PREVIEW_CANCEL": "pass_only_after_exact_preview_approval_and_no_submit",
    "CONFIRM_DELEGATED_PUBLICATION": "pass_only_after_single_final_exact_confirmation_and_submitter_identity_readback"
  },
  "completion_rule": "all_required_gates_pass; not_run_is_incomplete; withheld_remote_approval_is_incomplete_not_failed",
  "sensitive_test_markers": [
    "SYNTHETIC_PASSWORD_MARKER",
    "SYNTHETIC_TOKEN_MARKER",
    "SYNTHETIC_COOKIE_MARKER",
    "SYNTHETIC_MFA_MARKER",
    "SYNTHETIC_PERSONAL_DATA_MARKER"
  ]
}
